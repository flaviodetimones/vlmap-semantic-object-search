<?xml version="1.0"?>
<!--
  Official HSR in cafe.world with a safe spawn pose.

  Spawning at (0, 0) in cafe.world is unreliable for the HSR because the robot
  can start in collision-prone or actor-intersecting zones. This wrapper moves
  the robot to a verified free area.
-->
<launch>
  <arg name="world" default="/usr/share/gazebo-11/worlds/cafe.world"/>
  <arg name="paused" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="use_rviz" default="true"/>
  <arg name="rviz_config" default="$(find vlmap_bringup)/rviz/hsr_sensors.rviz"/>
  <arg name="posture_profile" default="sensor"/>
  <arg name="robot_x" default="6.0"/>
  <arg name="robot_y" default="6.0"/>
  <arg name="robot_z" default="0.05"/>
  <arg name="robot_yaw" default="0.0"/>

  <include file="$(find vlmap_bringup)/launch/hsr_gazebo_only.launch">
    <arg name="world" value="$(arg world)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="use_rviz" value="$(arg use_rviz)"/>
    <arg name="rviz_config" value="$(arg rviz_config)"/>
    <arg name="posture_profile" value="$(arg posture_profile)"/>
    <arg name="robot_x" value="$(arg robot_x)"/>
    <arg name="robot_y" value="$(arg robot_y)"/>
    <arg name="robot_z" value="$(arg robot_z)"/>
    <arg name="robot_yaw" value="$(arg robot_yaw)"/>
  </include>
</launch>
