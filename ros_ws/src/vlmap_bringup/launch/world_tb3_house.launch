<?xml version="1.0"?>
<!--
  Standalone launch: TurtleBot3 House world only (no robot, no stack).
  Forces GAZEBO_MODEL_PATH to include the package's models/ dir so
  furniture meshes resolve.
-->
<launch>
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>

  <env name="GAZEBO_MODEL_PATH"
       value="$(find turtlebot3_gazebo)/models:$(optenv GAZEBO_MODEL_PATH)"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find turtlebot3_gazebo)/worlds/turtlebot3_house.world"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
  </include>
</launch>
