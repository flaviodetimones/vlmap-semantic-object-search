#!/usr/bin/env python3
"""Capture HSR head_rgbd_sensor frames + map-frame pose to a VLMaps dataset.

Subscribes to RGB + depth (synchronized via message_filters), looks up the
``map -> base_link`` transform, applies a travel-distance / rotation
downsample, and writes:

    <output_dir>/
      rgb/000000.png      (BGR, the HSR Asus Xtion native format)
      depth/000000.npy    (float32, meters per pixel)
      poses.txt           (one tab-separated row per accepted frame)
      meta.json           (capture params + camera_info, written on stop)

Services:
    /vlmap_capture/start  (std_srvs/Trigger)  -- (re)open output dir
    /vlmap_capture/stop   (std_srvs/Trigger)  -- flush and freeze run

The node starts in "accepting" mode by default so a quick teleop session does
not need any service call.
"""

from __future__ import annotations

import json
import os
import threading
from pathlib import Path

import cv2
import numpy as np
import rospy
import tf2_ros
from cv_bridge import CvBridge
from geometry_msgs.msg import TransformStamped
from nav_msgs.msg import Odometry
from sensor_msgs.msg import CameraInfo, Image
from std_srvs.srv import Trigger, TriggerResponse

import message_filters

from vlmap_capture import (
    PoseSample,
    format_pose_line,
    should_accept_frame,
)


def _transform_to_pose(tf_msg: TransformStamped) -> PoseSample:
    t = tf_msg.transform.translation
    q = tf_msg.transform.rotation
    return PoseSample(t.x, t.y, t.z, q.x, q.y, q.z, q.w)


def _odom_to_pose(odom_msg: Odometry) -> PoseSample:
    # /odom carries the base pose in the odom frame. The capture stack pins
    # map->odom to identity (static_transform_publisher "0 0 0 0 0 0 map odom"),
    # so the odom-frame pose equals the map-frame pose. Used as a robust
    # fallback when the full TF chain (map->odom->base->...) is not yet
    # assembled at startup.
    p = odom_msg.pose.pose.position
    q = odom_msg.pose.pose.orientation
    return PoseSample(p.x, p.y, p.z, q.x, q.y, q.z, q.w)


class CaptureSession:
    def __init__(
        self,
        output_dir: Path,
        min_distance_m: float,
        min_angle_rad: float,
        depth_scale: float,
    ) -> None:
        self.output_dir = output_dir
        self.rgb_dir = output_dir / "rgb"
        self.depth_dir = output_dir / "depth"
        self.poses_path = output_dir / "poses.txt"
        self.meta_path = output_dir / "meta.json"
        self.min_distance_m = min_distance_m
        self.min_angle_rad = min_angle_rad
        self.depth_scale = depth_scale

        self.rgb_dir.mkdir(parents=True, exist_ok=True)
        self.depth_dir.mkdir(parents=True, exist_ok=True)
        self.poses_path.touch(exist_ok=True)

        self.frame_idx = 0
        self.last_accepted: PoseSample | None = None
        self.lock = threading.Lock()
        self.active = True

    def write_meta(self, camera_info: CameraInfo | None) -> None:
        meta = {
            "min_distance_m": self.min_distance_m,
            "min_angle_rad": self.min_angle_rad,
            "depth_scale": self.depth_scale,
            "frames_written": self.frame_idx,
            "camera_info": None,
        }
        if camera_info is not None:
            meta["camera_info"] = {
                "width": camera_info.width,
                "height": camera_info.height,
                "K": list(camera_info.K),
                "D": list(camera_info.D),
                "frame_id": camera_info.header.frame_id,
            }
        self.meta_path.write_text(json.dumps(meta, indent=2))

    def maybe_accept(
        self,
        pose: PoseSample,
        rgb_bgr: np.ndarray,
        depth_m: np.ndarray,
    ) -> bool:
        with self.lock:
            if not self.active:
                return False
            accept, reason = should_accept_frame(
                pose, self.last_accepted, self.min_distance_m, self.min_angle_rad
            )
            if not accept:
                return False
            stem = f"{self.frame_idx:06d}"
            cv2.imwrite(str(self.rgb_dir / f"{stem}.png"), rgb_bgr)
            np.save(self.depth_dir / f"{stem}.npy", depth_m.astype(np.float32))
            line = format_pose_line(pose)
            with self.poses_path.open("a") as fh:
                if self.frame_idx == 0:
                    fh.write(line)
                else:
                    fh.write("\n" + line)
            rospy.loginfo(
                "[vlmap_capture] frame %d accepted (%s) -> %s",
                self.frame_idx,
                reason,
                stem,
            )
            self.frame_idx += 1
            self.last_accepted = pose
            return True


def main() -> None:
    rospy.init_node("vlmap_capture", anonymous=False)

    rgb_topic = rospy.get_param(
        "~rgb_topic", "/hsrb/head_rgbd_sensor/rgb/image_rect_color"
    )
    depth_topic = rospy.get_param(
        "~depth_topic", "/hsrb/head_rgbd_sensor/depth_registered/image_rect_raw"
    )
    camera_info_topic = rospy.get_param(
        "~camera_info_topic", "/hsrb/head_rgbd_sensor/rgb/camera_info"
    )
    map_frame = rospy.get_param("~map_frame", "map")
    base_frame = rospy.get_param("~base_frame", "base_link")
    odom_topic = rospy.get_param("~odom_topic", "/odom")
    output_root = rospy.get_param("~output_root", "/shared/captures")
    world_name = rospy.get_param("~world_name", "world")
    run_id = rospy.get_param("~run_id", rospy.Time.now().to_nsec())
    min_distance_m = float(rospy.get_param("~min_distance_m", 0.20))
    min_angle_rad = float(rospy.get_param("~min_angle_rad", 0.35))  # ~20 deg
    sync_slop_s = float(rospy.get_param("~sync_slop_s", 0.05))
    depth_scale = float(rospy.get_param("~depth_scale", 1.0))  # depth already in metres

    output_dir = Path(output_root) / str(world_name) / str(run_id)
    session = CaptureSession(output_dir, min_distance_m, min_angle_rad, depth_scale)
    rospy.loginfo("[vlmap_capture] writing to %s", output_dir)

    bridge = CvBridge()
    tf_buffer = tf2_ros.Buffer(cache_time=rospy.Duration(10.0))
    tf2_ros.TransformListener(tf_buffer)

    latest_camera_info = {"msg": None}

    def _on_camera_info(msg: CameraInfo) -> None:
        latest_camera_info["msg"] = msg

    rospy.Subscriber(camera_info_topic, CameraInfo, _on_camera_info, queue_size=1)

    latest_odom = {"msg": None}

    def _on_odom(msg: Odometry) -> None:
        latest_odom["msg"] = msg

    rospy.Subscriber(odom_topic, Odometry, _on_odom, queue_size=1)

    def _on_pair(rgb_msg: Image, depth_msg: Image) -> None:
        pose = None
        try:
            tf_msg = tf_buffer.lookup_transform(
                map_frame, base_frame, rgb_msg.header.stamp, rospy.Duration(0.1)
            )
            pose = _transform_to_pose(tf_msg)
        except tf2_ros.TransformException as exc:
            # Includes ConnectivityException (map and base in separate trees
            # while the kinematic base TF is still being assembled at startup),
            # LookupException and ExtrapolationException. Instead of crashing
            # the synchronizer callback, fall back to /odom (map->odom is
            # identity) so capture keeps working.
            odom_msg = latest_odom["msg"]
            if odom_msg is not None:
                pose = _odom_to_pose(odom_msg)
                rospy.logwarn_throttle(
                    5.0,
                    "[vlmap_capture] TF %s->%s unavailable (%s); using /odom pose",
                    map_frame,
                    base_frame,
                    exc.__class__.__name__,
                )
            else:
                rospy.logwarn_throttle(
                    2.0,
                    "[vlmap_capture] TF unavailable and no /odom yet: %s",
                    exc,
                )
                return

        try:
            rgb_bgr = bridge.imgmsg_to_cv2(rgb_msg, desired_encoding="bgr8")
        except Exception as exc:  # noqa: BLE001
            rospy.logwarn_throttle(2.0, f"[vlmap_capture] RGB conversion failed: {exc}")
            return
        try:
            depth_raw = bridge.imgmsg_to_cv2(depth_msg, desired_encoding="passthrough")
        except Exception as exc:  # noqa: BLE001
            rospy.logwarn_throttle(2.0, f"[vlmap_capture] depth conversion failed: {exc}")
            return

        if depth_raw.dtype == np.uint16:
            # Standard ROS uint16 millimetres -> float32 metres.
            depth_m = depth_raw.astype(np.float32) / 1000.0
        else:
            depth_m = depth_raw.astype(np.float32) * session.depth_scale

        session.maybe_accept(pose, rgb_bgr, depth_m)

    rgb_sub = message_filters.Subscriber(rgb_topic, Image, queue_size=2)
    depth_sub = message_filters.Subscriber(depth_topic, Image, queue_size=2)
    sync = message_filters.ApproximateTimeSynchronizer(
        [rgb_sub, depth_sub], queue_size=10, slop=sync_slop_s
    )
    sync.registerCallback(_on_pair)

    def _start(_req):
        with session.lock:
            session.active = True
        rospy.loginfo("[vlmap_capture] capture resumed")
        return TriggerResponse(success=True, message="capturing")

    def _stop(_req):
        with session.lock:
            session.active = False
        session.write_meta(latest_camera_info["msg"])
        rospy.loginfo(
            "[vlmap_capture] capture paused. %d frame(s) written to %s",
            session.frame_idx,
            session.output_dir,
        )
        return TriggerResponse(success=True, message=f"{session.frame_idx} frames")

    rospy.Service("/vlmap_capture/start", Trigger, _start)
    rospy.Service("/vlmap_capture/stop", Trigger, _stop)

    rospy.loginfo(
        "[vlmap_capture] subscribed to %s + %s (sync slop %.2fs). Drive the robot now.",
        rgb_topic,
        depth_topic,
        sync_slop_s,
    )

    def _on_shutdown() -> None:
        try:
            session.write_meta(latest_camera_info["msg"])
            rospy.loginfo(
                "[vlmap_capture] shutdown: %d frame(s) flushed to %s",
                session.frame_idx,
                session.output_dir,
            )
        except Exception as exc:  # noqa: BLE001
            rospy.logwarn(f"[vlmap_capture] flush on shutdown failed: {exc}")

    rospy.on_shutdown(_on_shutdown)
    rospy.spin()


if __name__ == "__main__":
    try:
        main()
    except rospy.ROSInterruptException:
        pass
