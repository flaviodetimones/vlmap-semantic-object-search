#!/usr/bin/env python3
"""Sprint 1 stub for the YOLOE verifier node."""

import rospy
from std_msgs.msg import String


def main() -> None:
    rospy.init_node("yoloe_verifier", anonymous=False)
    rospy.loginfo("[yoloe_verifier] skeleton ready - Sprint 1")
    pub = rospy.Publisher("/vlmap/heartbeat", String, queue_size=10)
    rate = rospy.Rate(1.0)
    while not rospy.is_shutdown():
        pub.publish(String(data="yoloe_verifier alive"))
        rate.sleep()


if __name__ == "__main__":
    try:
        main()
    except rospy.ROSInterruptException:
        pass
