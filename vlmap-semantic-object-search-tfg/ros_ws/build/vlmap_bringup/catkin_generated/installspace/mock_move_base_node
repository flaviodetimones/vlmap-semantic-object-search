#!/usr/bin/env python3
"""Minimal fake move_base for smoke tests.

It listens to ``/move_base_simple/goal`` and emits a terminal
``/move_base/result`` after a configurable delay. This keeps the ROS migration
testable before Gazebo or a real local planner are integrated.
"""

from __future__ import annotations

from actionlib_msgs.msg import GoalID, GoalStatus
from geometry_msgs.msg import PoseStamped
from move_base_msgs.msg import MoveBaseActionResult
import rospy
from std_msgs.msg import String


def main() -> None:
    rospy.init_node("mock_move_base", anonymous=False)
    goal_topic = rospy.get_param("~goal_topic", "/move_base_simple/goal")
    result_topic = rospy.get_param("~result_topic", "/move_base/result")
    success_delay_s = float(rospy.get_param("~success_delay_s", 0.25))
    success_text = rospy.get_param("~success_text", "Mock goal reached.")

    heartbeat_pub = rospy.Publisher("/vlmap/heartbeat", String, queue_size=10)
    result_pub = rospy.Publisher(result_topic, MoveBaseActionResult, queue_size=10)
    state = {"last_goal": None}

    def _publish_success(_event) -> None:
        goal: PoseStamped | None = state["last_goal"]
        if goal is None:
            return
        msg = MoveBaseActionResult()
        msg.header.stamp = rospy.Time.now()
        msg.status = GoalStatus(
            goal_id=GoalID(id=""),
            status=GoalStatus.SUCCEEDED,
            text=str(success_text),
        )
        result_pub.publish(msg)
        rospy.loginfo(
            "[mock_move_base] success for goal frame=%s x=%.2f y=%.2f",
            goal.header.frame_id,
            goal.pose.position.x,
            goal.pose.position.y,
        )
        state["last_goal"] = None

    def _on_goal(msg: PoseStamped) -> None:
        state["last_goal"] = msg
        rospy.loginfo(
            "[mock_move_base] received goal frame=%s x=%.2f y=%.2f",
            msg.header.frame_id,
            msg.pose.position.x,
            msg.pose.position.y,
        )
        rospy.Timer(rospy.Duration(max(0.0, success_delay_s)), _publish_success, oneshot=True)

    rospy.Subscriber(goal_topic, PoseStamped, _on_goal, queue_size=10)
    rate = rospy.Rate(1.0)
    rospy.loginfo("[mock_move_base] ready")
    while not rospy.is_shutdown():
        status = "idle" if state["last_goal"] is None else "processing"
        heartbeat_pub.publish(String(data=f"mock_move_base alive {status}"))
        rate.sleep()


if __name__ == "__main__":
    try:
        main()
    except rospy.ROSInterruptException:
        pass
