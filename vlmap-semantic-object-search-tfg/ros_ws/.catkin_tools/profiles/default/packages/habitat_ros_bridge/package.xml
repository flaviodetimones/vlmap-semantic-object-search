<?xml version="1.0"?>
<package format="2">
  <name>habitat_ros_bridge</name>
  <version>0.1.0</version>
  <description>Publishes /map, /odom, /tf, /scan and RGBD from Habitat-Sim into ROS.</description>
  <maintainer email="mgarciablasco26@gmail.com">Mario Garcia Blasco</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
</package>
