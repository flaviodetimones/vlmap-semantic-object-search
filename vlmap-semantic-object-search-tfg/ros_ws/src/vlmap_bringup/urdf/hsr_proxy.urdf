<?xml version="1.0"?>
<robot name="vlmap_hsr_proxy">
  <!--
    HSR-like Gazebo proxy for integration testing.

    This is not a Toyota HSR model. It is a local, dependency-free robot that
    exposes the same base frames and core topics expected by the VLMap ROS
    contract so we can validate navigation, RGB-D and laser plumbing before the
    external HSR simulator packages are available.
  -->

  <material name="proxy_white">
    <color rgba="0.92 0.94 0.92 1.0"/>
  </material>
  <material name="proxy_dark">
    <color rgba="0.05 0.06 0.07 1.0"/>
  </material>
  <material name="proxy_blue">
    <color rgba="0.05 0.22 0.60 1.0"/>
  </material>

  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.28" rpy="0 0 0"/>
      <mass value="38.0"/>
      <inertia ixx="1.20" ixy="0.0" ixz="0.0" iyy="1.20" iyz="0.0" izz="1.70"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.22" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.31" length="0.44"/>
      </geometry>
      <material name="proxy_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.22" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.34" length="0.44"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.0" rpy="0 0 0"/>
  </joint>

  <link name="torso_link">
    <inertial>
      <origin xyz="0 0 0.85" rpy="0 0 0"/>
      <mass value="18.0"/>
      <inertia ixx="0.75" ixy="0.0" ixz="0.0" iyy="0.75" iyz="0.0" izz="0.55"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.85" rpy="0 0 0"/>
      <geometry>
        <box size="0.38 0.30 0.90"/>
      </geometry>
      <material name="proxy_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.85" rpy="0 0 0"/>
      <geometry>
        <box size="0.38 0.30 0.90"/>
      </geometry>
    </collision>
  </link>

  <joint name="torso_joint" type="fixed">
    <parent link="base_link"/>
    <child link="torso_link"/>
    <origin xyz="0 0 0.0" rpy="0 0 0"/>
  </joint>

  <link name="head_link">
    <inertial>
      <origin xyz="0.05 0 1.42" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.05"/>
    </inertial>
    <visual>
      <origin xyz="0.05 0 1.42" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.22 0.18"/>
      </geometry>
      <material name="proxy_white"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 1.42" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.22 0.18"/>
      </geometry>
    </collision>
  </link>

  <joint name="head_joint" type="fixed">
    <parent link="torso_link"/>
    <child link="head_link"/>
    <origin xyz="0 0 0.0" rpy="0 0 0"/>
  </joint>

  <link name="head_rgbd_sensor_rgb_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.10 0.04"/>
      </geometry>
      <material name="proxy_dark"/>
    </visual>
  </link>

  <joint name="head_rgbd_sensor_joint" type="fixed">
    <parent link="head_link"/>
    <child link="head_rgbd_sensor_rgb_frame"/>
    <origin xyz="0.18 0 1.42" rpy="0 0 0"/>
  </joint>

  <link name="base_laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.04"/>
      </geometry>
      <material name="proxy_dark"/>
    </visual>
  </link>

  <joint name="base_laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_laser_link"/>
    <origin xyz="0.24 0 0.32" rpy="0 0 0"/>
  </joint>

  <link name="left_wheel">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.045"/>
      </geometry>
      <material name="proxy_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.045"/>
      </geometry>
    </collision>
  </link>

  <link name="right_wheel">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.045"/>
      </geometry>
      <material name="proxy_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.045"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.28 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.28 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <gazebo reference="base_laser_link">
    <sensor type="ray" name="hsr_proxy_base_laser">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>241</samples>
            <resolution>1</resolution>
            <min_angle>-2.0944</min_angle>
            <max_angle>2.0944</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.08</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_hsr_proxy_laser" filename="libgazebo_ros_laser.so">
        <topicName>/hsrb/base_scan</topicName>
        <frameName>base_laser_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="head_rgbd_sensor_rgb_frame">
    <sensor type="depth" name="hsr_proxy_head_rgbd_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.10</near>
          <far>8.0</far>
        </clip>
      </camera>
      <plugin name="gazebo_ros_hsr_proxy_rgbd" filename="libgazebo_ros_openni_kinect.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>15.0</updateRate>
        <cameraName>/hsrb/head_rgbd_sensor</cameraName>
        <imageTopicName>rgb/image_rect_color</imageTopicName>
        <depthImageTopicName>depth_registered/image_rect_raw</depthImageTopicName>
        <cameraInfoTopicName>rgb/camera_info</cameraInfoTopicName>
        <depthImageCameraInfoTopicName>depth_registered/camera_info</depthImageCameraInfoTopicName>
        <pointCloudTopicName>depth_registered/rectified_points</pointCloudTopicName>
        <frameName>head_rgbd_sensor_rgb_frame</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="hsr_proxy_diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <commandTopic>/hsrb/command_velocity</commandTopic>
      <odometryTopic>/odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <publishTf>true</publishTf>
      <publishWheelTF>false</publishWheelTF>
      <publishOdomTF>true</publishOdomTF>
      <wheelSeparation>0.56</wheelSeparation>
      <wheelDiameter>0.20</wheelDiameter>
      <leftJoint>left_wheel_joint</leftJoint>
      <rightJoint>right_wheel_joint</rightJoint>
      <updateRate>30</updateRate>
      <torque>8.0</torque>
    </plugin>
  </gazebo>
</robot>
