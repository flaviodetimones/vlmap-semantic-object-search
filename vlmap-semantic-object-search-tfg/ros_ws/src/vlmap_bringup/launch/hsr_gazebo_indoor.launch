<?xml version="1.0"?>
<!--
  Official HSR in a static indoor world with a verified stable spawn pose.

  willowgarage.world is lightweight, static and available in stock Gazebo.
  The pose below was validated in-container for low drift and a usable RGB view
  after correcting the sensor posture profile.
-->
<launch>
  <arg name="world" default="/usr/share/gazebo-11/worlds/willowgarage.world"/>
  <arg name="paused" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="use_rviz" default="true"/>
  <arg name="rviz_config" default="$(find vlmap_bringup)/rviz/hsr_sensors.rviz"/>
  <arg name="posture_profile" default="sensor"/>
  <arg name="robot_x" default="4.0"/>
  <arg name="robot_y" default="0.0"/>
  <arg name="robot_z" default="0.05"/>
  <arg name="robot_yaw" default="-1.5708"/>

  <include file="$(find vlmap_bringup)/launch/hsr_gazebo_only.launch">
    <arg name="world" value="$(arg world)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="use_rviz" value="$(arg use_rviz)"/>
    <arg name="rviz_config" value="$(arg rviz_config)"/>
    <arg name="posture_profile" value="$(arg posture_profile)"/>
    <arg name="robot_x" value="$(arg robot_x)"/>
    <arg name="robot_y" value="$(arg robot_y)"/>
    <arg name="robot_z" value="$(arg robot_z)"/>
    <arg name="robot_yaw" value="$(arg robot_yaw)"/>
  </include>
</launch>
