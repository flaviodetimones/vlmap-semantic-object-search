<?xml version="1.0"?>
<!--
  Standalone launch: PAL Robotics 'home' world only (no robot, no stack).
  Forces GAZEBO_MODEL_PATH to include the package's models/ dir so
  furniture meshes resolve (kitchen, sofa, TV, IKEA chairs, etc).
-->
<launch>
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>

  <env name="GAZEBO_MODEL_PATH"
       value="$(find pal_gazebo_worlds)/models:$(optenv GAZEBO_MODEL_PATH)"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find pal_gazebo_worlds)/worlds/home.world"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
  </include>
</launch>
